# Large Model Binary Artifacts (>100MB exceeds GitHub push limits)
# Note: Random Forest models (~314MB) can be regenerated by running train_random_forest.py / run_phase7_1.py
*.joblib
!outputs/phase7_1/final_models/final_preprocessor.joblib
!outputs/phase7_1/final_models/logistic_regression_final.joblib
!outputs/phase7_1/final_models/decision_tree_final.joblib
!outputs/phase7_1/final_models/xgboost_final.joblib
!outputs/phase7_1/validation/val_preprocessor.joblib
!outputs/models/logistic_regression/logistic_regression_model.joblib
!outputs/models/decision_tree/decision_tree_model.joblib
!outputs/models/xgboost/xgboost_model.joblib
!data/processed/preprocessor.joblib

# Ignore the large Random Forest model binaries specifically
*random_forest*.joblib
